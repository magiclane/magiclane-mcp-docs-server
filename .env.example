# Copy to .env and adjust as needed.
# Every variable is OPTIONAL: with an empty .env the server works out of the
# box, because the documentation it serves is public and needs no credentials.
# `npm start` / `npm run start:http` do not read .env; load it with
#   node --env-file=.env dist/docs-server-http.esm.js
# ---------------------------------------------------------------------------
# General (both transports)
# ---------------------------------------------------------------------------
# Log each tool invocation (tool name) to stderr. Truthy: true, 1, yes, on
# (case-insensitive); anything else, including unset, is false.
# stdout is reserved for the MCP protocol, so diagnostics never go there.
# Default: false
VERBOSE=false

# ---------------------------------------------------------------------------
# Streamable HTTP transport only (npm run start:http / dev:http)
# ---------------------------------------------------------------------------

# Listen port. MCP_HTTP_PORT wins over PORT (set by Cloud Run and similar
# platforms); an empty value counts as unset, and a value that is not an
# integer in 1..65535 in decimal digits falls back to 3000. Left commented out
# so a platform's PORT is not overridden by a copied template.
# Default: 3000
# MCP_HTTP_PORT=3000

# Bind address. Use 0.0.0.0 to expose the server beyond localhost — put a
# reverse proxy in front when you do (see docs/http-server-setup.md). The
# Docker image sets 0.0.0.0 itself; left commented out so a .env passed with
# `docker run --env-file` does not bind the container to its own loopback.
# Default: 127.0.0.1
# MCP_HTTP_HOST=127.0.0.1

# Path of the MCP endpoint (POST only). Must start with "/", cannot be
# /health or /ready (always served separately) or "/", and holds no "?", "#"
# or space; anything else falls back to /mcp. A path other than /mcp is not
# named in the 404 for other paths.
# Default: /mcp
MCP_HTTP_PATH=/mcp

# CORS allow-origin policy. A comma-separated allowlist of browser origins, or
# * to allow any. Empty (the default) sends no CORS headers and refuses any
# request that carries an Origin header (403) — non-browser MCP clients send
# no Origin and are unaffected. Set this to your web client's origin
# (e.g. https://app.example.com) to allow it.
# WARNING: the server has no authentication, so MCP_CORS_ORIGIN=* lets any web
# page the user visits call a local instance from their browser.
# Default: (empty)
MCP_CORS_ORIGIN=

# Extra Host header values accepted, comma-separated. Loopback names
# (localhost, 127.0.0.1, [::1]) are always accepted on any port, and the bind
# address is accepted bare and with the listen port; add the public hostname(s)
# here when serving behind a proxy or domain, e.g. docs.example.com (also
# accepted with the listen port, :80 and :443; docs.example.com:443 also
# accepts the bare name). A rejected Host gets a 403 that names the value.
# Default: (empty)
MCP_ALLOWED_HOSTS=

# Validate the Host header against the allowlist. Truthy/falsy values as for
# VERBOSE; unset or blank means enabled — but ANY other value (a typo such as
# "enabled") turns the protection OFF. Leave enabled unless a trusted layer
# already validates Host for you.
# Default: true
MCP_DNS_REBINDING_PROTECTION=true

# Reverse proxies allowed to set X-Forwarded-For: comma-separated IPs or CIDR
# ranges, e.g. 10.0.0.5, 192.168.0.0/16, fd00::/8. The header is ignored from
# every other address — and entirely while this is empty, even with
# TRUSTED_PROXY_HOPS > 0: then all clients share the proxy's rate limit and
# concurrency share. Entries that are not addresses or ranges are ignored.
# In Docker, a proxy on the host reaches the container from the bridge
# gateway (172.17.0.1 on the default bridge), not from 127.0.0.1. Trusting
# the gateway trusts every process on the host that connects to the published
# port directly: keep the container reachable only through the proxy (same
# Docker network, port not published), see docs/http-server-setup.md.
# Default: (empty)
MCP_TRUSTED_PROXIES=

# Number of trusted reverse-proxy hops in front of the server (0..100). When
# > 0 and the peer is in MCP_TRUSTED_PROXIES, the client IP is the entry this
# many positions from the right of X-Forwarded-For; that entry must itself be
# an IP address, or the socket address is used. Set to 0 when there is no
# proxy. A single proxy on the same machine: MCP_TRUSTED_PROXIES=127.0.0.1 and
# TRUSTED_PROXY_HOPS=1. A value that is not a whole number from 0 to 100 in
# decimal digits (1e1, 0x2 and 2.0 are not) is ignored and read as 0 — the
# HTTP server says so on stderr at start.
# Default: 0
TRUSTED_PROXY_HOPS=0
